{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentloom:inter-agent-event:1",
  "title": "AgentLoom inter-agent event",
  "$defs": {
    "ResponseSentEvent": {
      "additionalProperties": false,
      "description": "A step finishes with its output.",
      "properties": {
        "event_id": {
          "description": "Derived from the step path, the type and the position.",
          "format": "uuid5",
          "title": "Event Id",
          "type": "string"
        },
        "agent_id": {
          "description": "The step's speaker, or the step itself when it has none.",
          "title": "Agent Id",
          "type": "string"
        },
        "step_id": {
          "description": "The step's path; a subworkflow's steps read parent.child.",
          "title": "Step Id",
          "type": "string"
        },
        "parent_event_ids": {
          "description": "The events this one causally follows, sorted.",
          "items": {
            "format": "uuid5",
            "type": "string"
          },
          "title": "Parent Event Ids",
          "type": "array"
        },
        "payload_hash": {
          "description": "SHA-256, 16-char prefix.",
          "pattern": "^[0-9a-f]{16}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "timestamp_ns": {
          "description": "Monotonic per process; never compared.",
          "minimum": 0,
          "title": "Timestamp Ns",
          "type": "integer"
        },
        "type": {
          "const": "response_sent",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "agent_id",
        "step_id",
        "payload_hash",
        "timestamp_ns",
        "type"
      ],
      "title": "ResponseSentEvent",
      "type": "object"
    },
    "StateTransitionEvent": {
      "additionalProperties": false,
