            "format": "uuid5",
            "type": "string"
          },
          "title": "Parent Event Ids",
          "type": "array"
        },
        "payload_hash": {
          "description": "SHA-256, 16-char prefix.",
          "pattern": "^[0-9a-f]{16}$",
