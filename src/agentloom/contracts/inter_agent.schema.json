          "title": "Agent Id",
          "type": "string"
        },
        "step_id": {
          "description": "The step's path; a subworkflow's steps read parent.child.",
          "title": "Step Id",
          "type": "string"
        },
        "parent_event_ids": {
          "description": "The events this one causally follows, sorted.",
          "items": {
            "format": "uuid5",
            "type": "string"
          },
          "title": "Parent Event Ids",
          "type": "array"
        },
        "payload_hash": {
          "description": "SHA-256, 16-char prefix.",
          "pattern": "^[0-9a-f]{16}$",
          "title": "Payload Hash",
