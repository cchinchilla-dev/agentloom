  },
  "discriminator": {
    "mapping": {
      "response_sent": "#/$defs/ResponseSentEvent",
      "state_transition": "#/$defs/StateTransitionEvent",
      "task_received": "#/$defs/TaskReceivedEvent",
      "task_sent": "#/$defs/TaskSentEvent",
      "tool_call": "#/$defs/ToolCallEvent",
      "tool_return": "#/$defs/ToolReturnEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TaskSentEvent"
    },
    {
      "$ref": "#/$defs/TaskReceivedEvent"
    },
    {
      "$ref": "#/$defs/ToolCallEvent"
    },
    {
      "$ref": "#/$defs/ToolReturnEvent"
    },
    {
      "$ref": "#/$defs/ResponseSentEvent"
    },
    {
      "$ref": "#/$defs/StateTransitionEvent"
    }
  ]
}
